from dataclasses import dataclass
from typing import Tuple

@dataclass
class OrganProfile: # defines physiological and prevention constraints for a transplantable organ
    name: str
    safe_temp_range: Tuple[float, float]
    max_transport_minutes: int
    risk_weight: float

